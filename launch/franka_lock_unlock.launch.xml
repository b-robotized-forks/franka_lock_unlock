<?xml version="1.0" encoding="UTF-8" ?>

<launch>
    <arg name="hostname" description="Hostname or IP address of the robot" />
    <arg name="username" description="Username for the robot web UI" />
    <arg name="password" description="Password for the robot web UI" />
    <arg name="enable_relock" default="true" description="Relock the brakes on exit" />
    <arg name="wait_web_ui" default="true" description="Wait in case the robot web UI is currently in use" />
    <arg name="request_physical_access" default="true" description="Request control by confirming physical access to the robot in case the robot web UI is currently in use" />
    <arg name="enable_fci" default="true" description="Activate the FCI" />
    <arg name="robot_type" default="fr3" description="Robot type">
        <choice value="fr3" />
        <choice value="panda" />
    </arg>
    <arg name="log_level" default="debug" description="Log level of the node" />
    <arg name="namespace" default="" description="Namespace of the node, e.g. &quot;robot1&quot; or &quot;cell_a/robot1&quot;" />

    <!-- Logger name of a namespaced node is "<ns>.<name>" (slashes become dots), e.g. "robot1.franka_lock_unlock_node" -->
    <let name="logger_name" value="$(eval &quot;'.'.join(filter(None, '$(var namespace)'.split('/') + ['franka_lock_unlock_node']))&quot;)" />

    <node pkg="franka_lock_unlock"
        name="franka_lock_unlock_node"
        namespace="$(var namespace)"
        exec="franka_lock_unlock_node"
        output="screen"
        emulate_tty="True"
        args="--ros-args --log-level $(var logger_name):=$(var log_level)">

        <!-- Node Parameters -->
        <param name="hostname" value="$(var hostname)" />
        <param name="username" value="$(var username)" />
        <param name="password" value="$(var password)" />
        <param name="enable_relock" value="$(var enable_relock)" />
        <param name="wait_web_ui" value="$(var wait_web_ui)" />
        <param name="request_physical_access" value="$(var request_physical_access)" />
        <param name="enable_fci" value="$(var enable_fci)" />
        <param name="robot_type" value="$(var robot_type)" />

    </node>
</launch>
