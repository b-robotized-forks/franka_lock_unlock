<launch>
    <arg name="hostname"/>
    <arg name="username"/>
    <arg name="password"/>
    <arg name="namespace" default=""/>

    <node name="franka_shutdown"
          namespace="$(var namespace)"
          pkg="franka_lock_unlock"
          exec="franka_shutdown"
          output="screen"
          emulate_tty="True"
          args="$(var hostname) $(var username) $(var password) -w -r"
    />
</launch>
